# Slack App credentials
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token
SLACK_SIGNING_SECRET=your-signing-secret

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# Nano Banana API (sketch & mockup generation)
NANO_BANANA_API_URL=https://api.nanobanana.com/v1
NANO_BANANA_API_KEY=your-nano-banana-key

# Google Gemini (AI text/vision)
GEMINI_KEY=your-gemini-key

# Anthropic Claude (factory notes generation)
ANTHROPIC_API_KEY=your-anthropic-key

# App settings
PORT=3000
UPLOAD_DIR=./uploads
NEW_SAMPLES_CHANNEL=new-samples
