{
  "name": "froo-slack-techpack",
  "version": "1.0.0",
  "description": "Slack-based Tech Pack Generator for FROO.studio — monitors #new-samples, builds factory-ready tech packs in Slack Canvas",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop froo-techpack",
    "pm2:restart": "pm2 restart froo-techpack",
    "pm2:logs": "pm2 logs froo-techpack"
  },
  "dependencies": {
    "@slack/bolt": "^4.1.0",
    "@slack/web-api": "^7.8.0",
    "@supabase/supabase-js": "^2.49.0",
    "axios": "^1.7.0",
    "dotenv": "^16.4.0",
    "sharp": "^0.33.0",
    "uuid": "^11.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
